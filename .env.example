# Google Sheets Web App URL (from Google Apps Script deployment)
# e.g., https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEETS_URL=""

# Shared secret sent with every Sheets read/write/delete request. Must match
# the "API_KEY" Script Property set on the Code.gs deployment (Project
# Settings > Script Properties). Generate a long random string — without
# this, anyone who finds the Web App URL can read/overwrite/delete all data.
VITE_SHEETS_API_KEY=""

# One-time bootstrap admin credential, used only until the admin's staff row
# has a real salted password hash (set one from the Roles page).
#
# NOT A SECRET: every VITE_* value is inlined into the public JS bundle at build
# time. Its purpose is to keep the admin password out of the source tree and to
# make it rotatable — leave it blank on any deployment where the admin already
# has a password set, which disables the bootstrap path entirely.
VITE_ADMIN_BOOTSTRAP_EMAIL=""
VITE_ADMIN_BOOTSTRAP_PASSWORD=""
